{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adsense-025",
  "mainBinaryName": "adsense-025",
  "version": "0.2.5",
  "identifier": "com.web3claw.google-adsense",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "google-adsense",
        "width": 1920,
        "height": 1200,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
